# =============================================================================
# LifeLink Environment Configuration Template
# Copy this file to `.env` and fill in your real credentials.
# NEVER commit `.env` or expose SUPABASE_SERVICE_ROLE_KEY in frontend code.
# =============================================================================

# Application Mode
APP_NAME=LifeLink
APP_ENV=development
APP_HOST=127.0.0.1
APP_PORT=8000
CORS_ORIGINS=http://127.0.0.1:8000,http://localhost:8000

# Local Development Mode
# When SUPABASE_URL is blank and DEV_AUTH_MODE=true, LifeLink runs against a
# local SQLite database with clearly labelled development-only auth so you can
# test workflows locally before connecting Supabase.
# Set DEV_AUTH_MODE=false in production!
DEV_AUTH_MODE=true
APP_JWT_SECRET=change-this-to-a-long-random-secret-in-local-dev
DEV_DB_PATH=backend/lifelink_dev.db

# Supabase Configuration (Required for Production / Live Cloud Database)
SUPABASE_URL=
SUPABASE_ANON_KEY=
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_JWT_SECRET=

# Optional Phone OTP / SMS Provider (configured inside Supabase Auth)
# Set to true only after configuring Twilio/MessageBird/Vonage in Supabase Auth
SUPABASE_PHONE_OTP_ENABLED=false

# Optional Live Aadhaar e-KYC / UIDAI ASA-KUA OTP Provider
# When false & DEV_AUTH_MODE=true, 12-digit Verhoeff checksum + hashed duplicate
# checks are still strictly enforced, with clearly labelled Dev Mode verification.
AADHAAR_KYC_ENABLED=false
AADHAAR_KYC_API_URL=
AADHAAR_KYC_API_KEY=

# Optional Geocoding / Maps Service
GEOCODING_API_KEY=

# Optional Official Blood-Bank Directory Integration (e.g., e-RaktKosh)
ERAKTKOSH_API_URL=
ERAKTKOSH_API_KEY=

# Optional Google Drive Verification Folder Integration
# Share the folder with your Google Service Account email (Editor) and set
# GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE for automatic server-to-Drive uploads.
GOOGLE_DRIVE_FOLDER_URL=
GOOGLE_DRIVE_FOLDER_ID=
GOOGLE_DRIVE_SERVICE_ACCOUNT_FILE=
